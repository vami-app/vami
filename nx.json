{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "cache": true
    },
    "lint": {
      "inputs": [
        "default"
      ],
      "cache": true
    },
    "typecheck": {
      "inputs": [
        "default"
      ],
      "cache": true
    },
    "dev": {
      "cache": false
    },
    "test": {
      "inputs": [
        "default"
      ],
      "cache": true
    }
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.[jt]s",
      "!{projectRoot}/**/*.test.[jt]s"
    ],
    "sharedGlobals": [
      {
        "env": "NODE_ENV"
      },
      {
        "env": "VITE_API_BASE_URL"
      },
      {
        "env": "VITE_IDENTITY_URL"
      }
    ]
  },
  "analytics": true
}
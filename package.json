{
  "name": "@vami/monorepo-root",
  "version": "0.0.0",
  "private": true,
  "description": "Production FAANG-grade monorepo architecture for Vami platform",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "build": "nx run-many -t build",
    "dev": "nx run-many -t dev --parallel=3",
    "dev:web": "nx run product-a-web:dev",
    "dev:api": "nx run product-a-api:dev",
    "dev:identity": "nx run service-identity:dev",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@nx/eslint-plugin": "^23.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "nx": "^23.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "express": "^5.2.1",
    "jose": "^6.2.4",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  }
}

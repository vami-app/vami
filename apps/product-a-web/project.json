{
  "name": "product-a-web",
  "sourceRoot": "apps/product-a-web/src",
  "projectType": "application",
  "tags": ["scope:app", "domain:product-a", "platform:web"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite",
        "cwd": "apps/product-a-web"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build",
        "cwd": "apps/product-a-web"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --reporter=verbose apps/product-a-web/src",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}

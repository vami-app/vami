# Product A API — Environment Variables Template
# Copy this file to .env.development or .env.local for local development.

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Redis Connection (Rate Limiting, Circuit Breaker, Session Verification Cache)
REDIS_URL=redis://localhost:6379

# Platform Identity Service Public JWKS URL
IDENTITY_SERVICE_URL=http://localhost:5000

# Shared Security Secrets
PAGINATION_SECRET=dev-pagination-secret-32-chars-long!

{
  "compilerOptions": {
    "checkJs": true,
    "jsx": "preserve",
    "maxNodeModuleJsDepth": 0,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/components/*": ["./components/*"],
      "@/features/*": ["./features/*"],
      "@/styles/*": ["./styles/*"]
    }
  },
  "include": ["**/*.js", "**/*.jsx"]
}

# Server
PORT=5000
NODE_ENV=development

# Client origin (for CORS + cookies)
CLIENT_URL=http://localhost:3000

# MongoDB (local instance)
MONGO_URI=mongodb://127.0.0.1:27017/inkwell

# JWT secrets — CHANGE THESE in production
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me

# Token lifetimes
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cookie config
COOKIE_SECURE=false

# Email (password reset). Leave all unset to print emails to the server console.
# Dev: Mailtrap sandbox (never reaches real inboxes)
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
# Prod: Resend HTTP API (requires SPF/DKIM on the sending domain)
RESEND_API_KEY=
EMAIL_FROM=Inkwell <onboarding@resend.dev>

# OAuth 2.0 Credentials (Optional)
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Identity Service — Environment Variables Template
# Copy this file to .env.development or .env.local for local development.

PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Redis Connection (Session Store & Revocation JTI Tracking)
REDIS_URL=redis://localhost:6379

# RSA Key Pair Configuration for OpenID Connect / JWKS Signing
# In production, RSA private key is injected via Secret Manager
RSA_KEY_SIZE=2048
ISSUER_URL=http://localhost:5000
